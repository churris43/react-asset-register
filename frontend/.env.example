# -------------------------------------------------------
# API
# -------------------------------------------------------

# Base URL of the Express backend API
# Docker Compose: API_URL=http://api:3000  (service name)
# Production: API_URL=https://your-api.example.com
API_URL=http://api:3000

# -------------------------------------------------------
# Authentication
# -------------------------------------------------------

# Must match the JWT_SECRET set in the backend — used by Next.js middleware
# to verify tokens on the Edge Runtime without calling the backend.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
