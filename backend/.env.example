# -------------------------------------------------------
# Server
# -------------------------------------------------------

# Port the Express API listens on
# Example: PORT=3000
PORT=3000

# -------------------------------------------------------
# Database connection (runtime)
# Used by Prisma client via the MariaDB adapter at runtime
# -------------------------------------------------------

# Hostname of the MySQL/MariaDB server
# Docker Compose: DATABASE_HOST=mysql  (service name)
# Local (no Docker): DATABASE_HOST=localhost
# Production (e.g. Railway): DATABASE_HOST=mysql.railway.internal
DATABASE_HOST=

# MySQL user that the app connects as
# Example: DATABASE_USER=assetregister_user
DATABASE_USER=

# Password for the above user
# Example: DATABASE_PASSWORD=a8f3$Kp2!mNqR
DATABASE_PASSWORD=

# Name of the database schema
# Example: DATABASE_NAME=assetregister
DATABASE_NAME=

# Port MySQL is listening on (usually 3306)
DATABASE_PORT=3306

# -------------------------------------------------------
# Database connection (migrations)
# Used by the Prisma CLI when running migrations
# Must match the individual vars above
# -------------------------------------------------------

# Full DSN used by Prisma CLI for migrations
# Format: mysql://<user>:<password>@<host>:<port>/<database>
# Example: DATABASE_URL=mysql://assetregister_user:a8f3$Kp2!mNqR@localhost:3306/assetregister
DATABASE_URL=

# Shadow database used by Prisma during migration generation (can be the same host, different schema)
# Example: SHADOW_DATABASE_URL=mysql://root:rootpassword@localhost:3306/assetregister_shadow
SHADOW_DATABASE_URL=

# -------------------------------------------------------
# CORS
# -------------------------------------------------------

# URL of the frontend app, used to restrict cross-origin requests to the API
# Only required in production when frontend and backend are on separate domains
# Example: FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=
