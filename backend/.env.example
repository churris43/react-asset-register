# -------------------------------------------------------
# Server
# -------------------------------------------------------

# Port the Express API listens on
# Example: PORT=3000
PORT=3000

# -------------------------------------------------------
# Database connection - MariaDB adapter (commented out - replaced by PostgreSQL)
# -------------------------------------------------------

# # Hostname of the MySQL/MariaDB server
# DATABASE_HOST=
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_NAME=
# DATABASE_PORT=3306

# -------------------------------------------------------
# Database connection
# Full DSN used by Prisma client and CLI
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# -------------------------------------------------------

# Example: DATABASE_URL=postgresql://assetregister_user:a8f3$Kp2!mNqR@postgres:5432/assetregister
DATABASE_URL=

# Shadow database used by Prisma during migration generation (commented out - managed via prisma.config.ts)
# SHADOW_DATABASE_URL=

# -------------------------------------------------------
# Authentication
# -------------------------------------------------------

# Secret key used to sign and verify JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# -------------------------------------------------------
# CORS
# -------------------------------------------------------

# URL of the frontend app, used to restrict cross-origin requests to the API
# Only required in production when frontend and backend are on separate domains
# Example: FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=
