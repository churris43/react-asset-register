# -------------------------------------------------------
# API
# -------------------------------------------------------

# Port the Express API listens on
PORT=3000

# -------------------------------------------------------
# MySQL (commented out - replaced by PostgreSQL)
# Used by the mysql Docker service and the migrate service
# -------------------------------------------------------

# # Hostname of the MySQL container (Docker service name)
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_DATABASE=assetregister
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=

# -------------------------------------------------------
# PostgreSQL
# Used by the postgres Docker service and the migrate service
# -------------------------------------------------------

# Hostname of the PostgreSQL container (Docker service name)
# Docker Compose: POSTGRES_HOST=postgres
POSTGRES_HOST=postgres

# PostgreSQL port (usually 5432)
POSTGRES_PORT=5432

# Name of the database to create
# Example: POSTGRES_DB=assetregister
POSTGRES_DB=assetregister

# Application database user
# Example: POSTGRES_USER=assetregister_user
POSTGRES_USER=

# Password for the application user
# Example: POSTGRES_PASSWORD=a8f3$Kp2!mNqR
POSTGRES_PASSWORD=

# -------------------------------------------------------
# Prisma
# Full DSN used by the api and migrate containers
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# -------------------------------------------------------

# Example: DATABASE_URL=postgresql://assetregister_user:a8f3$Kp2!mNqR@postgres:5432/assetregister
DATABASE_URL=

# -------------------------------------------------------
# Auth
# -------------------------------------------------------

# Secret key used to sign and verify JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# -------------------------------------------------------
# CORS
# -------------------------------------------------------

# URL of the frontend app, used to restrict cross-origin requests to the API
# Example: FRONTEND_URL=http://localhost
FRONTEND_URL=
