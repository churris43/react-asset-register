# -------------------------------------------------------
# API
# -------------------------------------------------------

# Port the Express API listens on
PORT=3000

# -------------------------------------------------------
# MySQL
# Used by the mysql Docker service and the migrate service
# -------------------------------------------------------

# Hostname of the MySQL container (Docker service name)
# Docker Compose: MYSQL_HOST=mysql
# Production: set to your hosted DB hostname
MYSQL_HOST=mysql

# MySQL port (usually 3306)
MYSQL_PORT=3306

# Name of the database schema to create
# Example: MYSQL_DATABASE=assetregister
MYSQL_DATABASE=assetregister

# Application database user
# Example: MYSQL_USER=assetregister_user
MYSQL_USER=

# Password for the application user
# Example: MYSQL_PASSWORD=a8f3$Kp2!mNqR
MYSQL_PASSWORD=

# Root password for the MySQL container
# Example: MYSQL_ROOT_PASSWORD=s0m3$tr0ngP@ss
MYSQL_ROOT_PASSWORD=

# -------------------------------------------------------
# Prisma (migrations inside Docker)
# Full DSN used by the api container for Prisma migrations
# Format: mysql://<user>:<password>@<host>:<port>/<database>
# -------------------------------------------------------

# Example: DATABASE_URL=mysql://assetregister_user:a8f3$Kp2!mNqR@mysql:3306/assetregister
DATABASE_URL=
